# Finnhub
FINNHUB_API_KEY=replace_me
SYMBOLS=AAPL,MSFT,TSLA,NVDA,AMZN
POLL_INTERVAL_SECONDS=30
SEEN_IDS_MAX=5000

# Kafka (use kafka:29092 inside Docker, localhost:9092 from host scripts)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Postgres
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline_secret
POSTGRES_DB=market_data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DB consumer batching
DB_BATCH_SIZE=200
DB_FLUSH_INTERVAL=2

# NLP (8GB box: keep at 2)
NLP_NUM_THREADS=2
FINBERT_MODEL=ProsusAI/finbert

# Decision engine
# Open a position when |aggregated sentiment| crosses this threshold
OPEN_THRESHOLD=0.4
# Take-profit and stop-loss as fraction of entry price
TARGET_PCT=0.01
STOP_PCT=0.005
# Max time a position can stay open before auto-close (minutes)
HORIZON_MINUTES=240
HORIZON_LABEL=intraday
# Sentiment decay
SENTIMENT_HALF_LIFE_S=1800
SENTIMENT_HISTORY=50
