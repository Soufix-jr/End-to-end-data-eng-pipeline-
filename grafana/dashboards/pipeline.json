{
  "uid": "pipeline-main",
  "title": "Market Intelligence Pipeline",
  "description": "Live trades, FinBERT sentiment, decisions and P&L",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["pipeline", "trading", "finbert"],
  "timezone": "browser",
  "style": "dark",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": true,
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbol",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "Timescale" },
        "query": "SELECT DISTINCT symbol FROM raw_trades ORDER BY 1",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Signals",
        "datasource": { "type": "postgres", "uid": "Timescale" },
        "enable": true,
        "iconColor": "#FF9830",
        "target": {
          "rawQuery": true,
          "rawSql": "SELECT time AS time, symbol || ' ' || action AS text, action AS tags FROM signals WHERE $__timeFilter(time)",
          "format": "table"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 1,
      "title": "P&L last 24h",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT COALESCE(SUM(pnl_pct), 0) AS \"P&L %\" FROM positions WHERE status='CLOSED' AND exit_time > now() - interval '24 hours'"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "orange","value": -0.5 },
              { "color": "yellow","value": 0 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Win rate 24h",
      "type": "gauge",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT 100.0 * SUM(CASE WHEN pnl_pct > 0 THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0) AS \"Win %\" FROM positions WHERE status='CLOSED' AND exit_time > now() - interval '24 hours'"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 50 },
              { "color": "green",  "value": 60 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Open positions",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT COUNT(*) AS \"Open\" FROM positions WHERE status='OPEN'"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",  "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Articles scored (1h)",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 5 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT COUNT(*) AS \"Articles\" FROM nlp_results WHERE processed_at > now() - interval '1 hour'"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green",  "value": 10 }
            ]
          }
        }
      }
    },

    {
      "type": "row",
      "id": 101,
      "title": "Market & sentiment",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 }
    },
    {
      "id": 5,
      "title": "Price by symbol",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 0, "y": 7, "w": 14, "h": 9 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "min", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [{
        "format": "time_series",
        "rawSql": "SELECT time AS \"time\", symbol AS metric, price FROM raw_trades WHERE $__timeFilter(time) ORDER BY time"
      }]
    },
    {
      "id": 6,
      "title": "Sentiment distribution",
      "type": "piechart",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 14, "y": 7, "w": 10, "h": 9 },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "list", "placement": "bottom", "values": ["value", "percent"] },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "mappings": []
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "positive" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "negative" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red"   } }] },
          { "matcher": { "id": "byName", "options": "neutral"  }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue"  } }] }
        ]
      },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT sentiment AS metric, COUNT(*)::int AS value FROM nlp_results WHERE processed_at > now() - interval '24 hours' GROUP BY sentiment"
      }]
    },

    {
      "id": 7,
      "title": "Aggregated sentiment score over time",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 0, "y": 16, "w": 14, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "min": -1,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 25,
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": -0.1 },
              { "color": "green",  "value": 0.1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "format": "time_series",
        "rawSql": "SELECT time_bucket('1 minute', n.published_at) AS \"time\", AVG(CASE WHEN r.sentiment='positive' THEN r.sentiment_score WHEN r.sentiment='negative' THEN -r.sentiment_score ELSE 0 END) AS score FROM nlp_results r JOIN raw_news n ON n.id = r.news_id WHERE $__timeFilter(n.published_at) GROUP BY 1 ORDER BY 1"
      }]
    },
    {
      "id": 8,
      "title": "Trades per minute",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 14, "y": 16, "w": 10, "h": 8 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "hidden" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "barAlignment": 0
          },
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      },
      "targets": [{
        "format": "time_series",
        "rawSql": "SELECT time_bucket('1 minute', time) AS \"time\", COUNT(*)::int AS trades FROM raw_trades WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
      }]
    },

    {
      "type": "row",
      "id": 102,
      "title": "Decisions & positions",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 }
    },
    {
      "id": 9,
      "title": "Recent signals",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 8 },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "action" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "OPEN_LONG":  { "color": "green",  "index": 0 } } },
                { "type": "value", "options": { "OPEN_SHORT": { "color": "red",    "index": 1 } } },
                { "type": "value", "options": { "CLOSE":      { "color": "orange", "index": 2 } } }
              ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "confidence" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "price" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 2 }
            ]
          }
        ]
      },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT time, symbol, action, price, confidence, horizon, reason FROM signals WHERE $__timeFilter(time) ORDER BY time DESC LIMIT 100"
      }]
    },
    {
      "id": 10,
      "title": "Open positions",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 0, "y": 33, "w": 12, "h": 9 },
      "options": { "showHeader": true, "footer": { "show": false } },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "side" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "LONG":  { "color": "green", "index": 0 } } },
                { "type": "value", "options": { "SHORT": { "color": "red",   "index": 1 } } }
              ] }
            ]
          },
          { "matcher": { "id": "byRegexp", "options": ".*price$" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 2 }] },
          { "matcher": { "id": "byName", "options": "confidence" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 2 }] }
        ]
      },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT id, symbol, side, entry_time, entry_price, target_price, stop_price, valid_until, confidence FROM positions WHERE status='OPEN' ORDER BY entry_time DESC"
      }]
    },
    {
      "id": 11,
      "title": "Closed positions (last 50)",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "Timescale" },
      "gridPos": { "x": 12, "y": 33, "w": 12, "h": 9 },
      "options": { "showHeader": true, "footer": { "show": false } },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "side" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "LONG":  { "color": "green", "index": 0 } } },
                { "type": "value", "options": { "SHORT": { "color": "red",   "index": 1 } } }
              ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "pnl_pct" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  { "color": "red",    "value": null },
                  { "color": "orange", "value": -0.2 },
                  { "color": "yellow", "value": 0 },
                  { "color": "green",  "value": 0.2 }
                ]
              } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "exit_reason" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "target_hit": { "color": "green",  "index": 0 } } },
                { "type": "value", "options": { "stop_hit":   { "color": "red",    "index": 1 } } },
                { "type": "value", "options": { "expired":    { "color": "orange", "index": 2 } } },
                { "type": "value", "options": { "flip":       { "color": "purple", "index": 3 } } }
              ] }
            ]
          },
          { "matcher": { "id": "byRegexp", "options": ".*price$" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 2 }] }
        ]
      },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT entry_time, symbol, side, entry_price, exit_price, exit_reason, pnl_pct FROM positions WHERE status='CLOSED' ORDER BY exit_time DESC NULLS LAST LIMIT 50"
      }]
    }
  ]
}
